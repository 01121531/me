{
  "name": "assistant-task-board",
  "version": "1.0.0",
  "description": "Personal assistant task progress board with MySQL persistence.",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "start": "node server/index.js",
    "ai:worker": "node server/ai/worker.js",
    "build": "vite build",
    "init-db": "node server/scripts/init-db.js",
    "backup:create": "node server/scripts/backup.js create",
    "backup:verify": "node server/scripts/backup.js verify",
    "backup:restore": "node server/scripts/backup.js restore",
    "check:system": "node server/scripts/system-check.js",
    "smoke": "node server/scripts/smoke-test.js",
    "smoke:index-queue": "node server/scripts/index-queue-smoke-test.js",
    "smoke:attachments": "node server/scripts/attachment-text-smoke-test.js",
    "smoke:llamaindex": "node server/scripts/llama-index-smoke-test.js",
    "smoke:mcp": "node server/scripts/mcp-read-smoke-test.js",
    "smoke:mcp-actions": "node server/scripts/mcp-action-smoke-test.js",
    "ocr:backfill": "node server/scripts/ocr-backfill.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@llamaindex/openai": "^0.4.22",
    "@llamaindex/qdrant": "^0.1.32",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/canvas": "^1.0.1",
    "@qdrant/js-client-rest": "^1.18.0",
    "@tiptap/core": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "cors": "^2.8.6",
    "dompurify": "^3.4.11",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "llamaindex": "^0.12.1",
    "lucide-react": "^1.21.0",
    "mammoth": "^1.12.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "mysql2": "^3.22.5",
    "openai": "^6.44.0",
    "openid-client": "^6.8.4",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.296",
    "pdfkit": "^0.19.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "vite": "^8.0.16"
  }
}
