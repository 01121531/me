PORT=3000
PM2_APP=assistant-task-board
UPDATE_BRANCH=main
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=assistant_task_board
DB_PASSWORD=replace-with-your-db-password
DB_DATABASE=assistant_task_board

# Development uses the local uploads directory. Production should use S3 or MinIO.
STORAGE_DRIVER=local
# In production, point DATA_ROOT to a persistent directory outside the release folder.
# When STORAGE_LOCAL_ROOT is omitted, new resources are stored in DATA_ROOT/resources.
DATA_ROOT=
STORAGE_LOCAL_ROOT=./uploads
# Optional Chinese font for PDF exports. Example: /usr/share/fonts/opentype/noto/NotoSansCJK-Regular.otf
PDF_FONT_PATH=
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=assistant-task-board
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=true

# Use "password" for a simple single-password gate, or "oidc" for provider login.
AUTH_MODE=disabled
SESSION_SECRET=replace-with-a-long-random-value
AUTH_PASSWORD_HASH=pbkdf2-sha256$210000$replace-salt$replace-hash
AUTH_SECURE_COOKIES=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
OIDC_ISSUER=https://issuer.example.com
OIDC_CLIENT_ID=assistant-task-board
OIDC_CLIENT_SECRET=replace-me
OIDC_REDIRECT_URI=https://tasks.example.com/auth/callback
OIDC_SCOPE=openid profile email
# Optional comma-separated OIDC subject allowlist.
OIDC_ALLOWED_SUBJECTS=

# AI workers are opt-in. Models are reached only through LiteLLM's OpenAI-compatible endpoint.
AI_INDEXING_ENABLED=false
AI_INDEX_VERSION=2
AI_WORKER_POLL_MS=1500
AI_WORKER_MAX_ATTEMPTS=5
AI_ATTACHMENT_PARSE_MAX_BYTES=12582912
AI_ATTACHMENT_TEXT_MAX_CHARS=80000
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=
OCR_MAX_PDF_PAGES=20
OCR_BATCH_PAGES=4
OCR_PDF_RENDER_SCALE=1.2
OCR_MIN_TEXT_CHARS=80
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_API_KEY=replace-me
LITELLM_EMBEDDING_MODEL=embeddings-primary
LITELLM_CHAT_MODEL=chat-primary
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=assistant_task_board

# Private MCP endpoint for OpenClaw. Keep disabled until deployed behind HTTPS and a strong token.
MCP_ENABLED=false
MCP_TOKEN=replace-with-a-long-random-token

# Personal WeChat channel (Tencent iLink / ClawBot). Credentials are created by
# QR login and encrypted under .deploy; no OpenClaw runtime is required.
WEIXIN_API_BASE_URL=https://ilinkai.weixin.qq.com
WEIXIN_CDN_BASE_URL=https://novac2c.cdn.weixin.qq.com/c2c
WEIXIN_TEMP_TTL_HOURS=24
WEIXIN_MAX_MEDIA_BYTES=52428800
